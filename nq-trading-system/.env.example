# ============================================================================
# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore — NUNCA lo commitees.
# ============================================================================

# --- Telegram (Parte 2: alertas en vivo) ---------------------------------
# 1. Hablale a @BotFather en Telegram -> /newbot -> te da el token.
# 2. Para el chat_id: mandale un mensaje a tu bot y abrí
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
#    Para un grupo, el chat_id es negativo (ej: -1001234567890).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Proveedor de datos en vivo -------------------------------------------
# Ver docs/DATA_PROVIDERS.md para la comparación completa.
# Recomendado para free tier: Twelve Data.
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Alternativas (dejar vacías si no las usás)
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# --- Signal service (opcional, ver n8n/README.md) --------------------------
# Si corrés src/signal_service.py para que n8n reuse la estrategia Python
# literal en vez de la port a JS.
SIGNAL_SERVICE_URL=http://localhost:8000
SIGNAL_SERVICE_TOKEN=change_me_shared_secret

# --- Backtester -----------------------------------------------------------
# Overrides opcionales de config.yaml (tienen prioridad sobre el YAML).
# BACKTEST_TICKER=NQ=F
# BACKTEST_INTERVAL=5m

# Solo necesario detrás de un proxy que re-termina TLS (entornos corporativos
# o sandboxes). Fuerza el perfil TLS que usa yfinance por debajo.
# Valores útiles: chrome110, chrome116, safari15_5
# YF_IMPERSONATE=
